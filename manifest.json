{
  "manifest_version": 3,
  "name": "Theme Studio for LeetCode",
  "version": "1.0.0",
  "description": "Fresh themes for LeetCode: 8 worlds with painted scenery, glass panels, a themed editor and an Accepted finisher.",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Theme Studio",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["src/themes.js", "src/scenery.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*.woff2"], "matches": ["https://leetcode.com/*"] }
  ]
}
